{
  "manifest_version": 3,
  "name": "JobMatch AI Autofill",
  "version": "0.5.0",
  "description": "Tailor your saved resume and fill application details on Greenhouse and Lever in one click.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "downloads"
  ],
  "action": {
    "default_title": "JobMatch AI"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
